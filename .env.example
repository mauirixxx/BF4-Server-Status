# Discord bot token
DISCORD_TOKEN=

# Database connection. PostgreSQL is the primary deployment target.
# See DATABASE.md for PostgreSQL / MySQL / MariaDB URL examples.
DATABASE_URL=postgresql+psycopg://bf4_serverwatcher:PASSWORD@host.docker.internal:5432/bf4_serverwatcher

# Global polling interval for the shared/deduplicated BF4 server monitor.
CHECK_INTERVAL_SECONDS=69

# Global Discord presence rotation interval.
PRESENCE_UPDATE_SECONDS=30

# Optional runtime logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Migration-only option for v1.x upgrades when the bot is connected to
# multiple Discord guilds. Do not leave this set after migration completes.
# LEGACY_IMPORT_GUILD_ID=

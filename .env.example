# Discord bot token
DISCORD_TOKEN=

# Database connection. PostgreSQL is the primary deployment target.
# See DATABASE.md for PostgreSQL / MySQL / MariaDB URL examples.
DATABASE_URL=postgresql+psycopg://bf4_serverwatcher:PASSWORD@host.docker.internal:5432/bf4_serverwatcher

# Global polling interval for the shared/deduplicated BF4 server monitor.
CHECK_INTERVAL_SECONDS=69

# Bounded external lookup concurrency. Three workers is the recommended default.
EXTERNAL_LOOKUP_WORKERS=3

# Shared Keeper/Battlelog request-start rate limit across all lookup workers.
# Production baseline request-start rate. PR1 keeps this unchanged at 0.33.
EXTERNAL_REQUESTS_PER_SECOND=0.33

# Fallback cooldown if Battlelog returns HTTP 429 without Retry-After.
BATTLELOG_DEFAULT_429_BACKOFF_SECONDS=30

# Per-server cooldown for transient Keeper HTTP 403 responses.
KEEPER_SERVER_403_BACKOFF_SECONDS=300

# Global Discord presence rotation interval.
PRESENCE_UPDATE_SECONDS=30

# Optional runtime logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Migration-only option for v1.x upgrades when the bot is connected to
# multiple Discord guilds. Do not leave this set after migration completes.
# LEGACY_IMPORT_GUILD_ID=

# Total idle time after each completed Keeper sweep before the next sweep starts.
# Large-scale testing found 300 seconds safer than only the normal 120-second gap.
KEEPER_INTER_SWEEP_COOLDOWN_SECONDS=300

# v2.6.6-pr1 experiment: process Keeper snapshots in bounded batches.
# Poll at most 60 servers, then pause 60 seconds before the next batch.
KEEPER_BATCH_SIZE=60
KEEPER_BATCH_PAUSE_SECONDS=60

# Stop the current Keeper sweep after this many consecutive HTTP 403s.
# This protects Keeper from continued requests once the observed 403 wall begins.
KEEPER_403_FLOOD_THRESHOLD=3

# Minimum successful-server ratio required to refresh the player-count presence.
# 0.99 allows a tiny number of isolated failures without blocking presence forever.
KEEPER_PRESENCE_MIN_SUCCESS_RATIO=0.99

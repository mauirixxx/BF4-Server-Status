# PostgreSQL only. Use the dedicated SELECT-only dashboard login.
DATABASE_URL=postgresql://bf4_dashboard_readonly:replace_me@db.example.internal:5432/bf4_serverwatcher
APP_ENV=production
DB_STATEMENT_TIMEOUT_MS=5000
SNAPSHOT_FRESH_SECONDS=900
# Strict freshness remains the 15-minute diagnostic view.
SNAPSHOT_ADAPTIVE_SECONDS=3972
PRESENCE_HEALTHY_COVERAGE_PCT=90.0
WORKER_HEALTHY_SECONDS=60
WORKER_WARNING_SECONDS=180
PUBLIC_OPERATOR_PANEL=false

# Phase 2 sampler uses a separate root-controlled file:
# /etc/bf4-status-dashboard/sampler.env
# SAMPLER_DATABASE_URL=postgresql://bf4_dashboard_sampler:replace_me@db.example.internal:5432/bf4_serverwatcher
